<!DOCTYPE html>
<html lang="en">
<head>

    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://kit.fontawesome.com/dce6efa4ea.js" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="{{ css_footer_file }}" type="text/css">
    <link rel="stylesheet" href="{{ css_nav_file }}" type="text/css">
    <link rel="stylesheet" href="{{ css_file }}" type="text/css">   

    

    <title>{{ page_title }}</title>
</head>
<body>
        <div class="body">
            <div class="rightclickmenu hidden" id="rightclickmenu">
                <div class="rootchild list menuitem">Add >
                    <div class="listwrapper hidden">
                        <div class="addoptions list menuitem">Before >     
                            <div class="listwrapper hidden">
                                <div id="beforetext" class="menuitem">Text</div>                             
                            </div>                     
                        </div>
                        <div class="addoptions list menuitem">After >
                            <div class="listwrapper hidden">
                                <div id="aftertext" class="menuitem">Text</div>                             
                            </div>
                        </div>               
                    </div>
                </div>                                      
                <div class="rootchild menuitem" id="deleteoption">Delete</div>
            </div>
    
            <header>
                <nav id="contentmanagernav">
                    <a href="/HighFlyersUkCouriers/public/logout">Logout</a>
                    <a href="/HighFlyersUkCouriers/public/manage-orders">Manage Bookings</a>
                    <a href="/HighFlyersUkCouriers/public/content-manager">Content Manager</a>                
                    <a href="/HighFlyersUkCouriers/public/manage-accounts">Manage Accounts</a>
                </nav>
            </header>
            <div class="contentmanagermaincontent">
                <div class="contentmanagerwrapper">                    
                    <div class="objecttreewindow window">
                        <div class="selectpagewrapper">                          
                            <form method="post" action="content-manager">
                                <input id="editabledocumentvalue" type="hidden" name="editabledocumentvalue">
                                <input id="fontlinks" type="hidden" name="fontlinks">
                                <input id="filename" type="hidden" name="filename">
                                <input is="save" type="button" onclick="savePage()" value="Save">
                            </form>                                              
                            <select class='selectpage' onchange="selectOnChange()" id="selectpage">
                                <option value="NewHomepage.twig">Homepage</option>
                                <option value="NewBooking.twig">Booking</option>
                                <option value="NewFAQ.twig">FAQ</option>
                                <option value="NewPrices.twig">Prices</option>
                                <option value="NewContactUs.twig">ContactUs</option>
                        
                            </select>
                            {# <select class='selectresolution' onchange="selectResolutionOnChange()" id="selectresolution">
                                <option value="1920">1920</option>
                                <option value="874">A5</option>                            
                            </select> #}
                        </div>
                        <div class="objecttree">                            
                        </div>
                    </div>
                    <div class="leftdraggable draggable">              
                    </div>
                    <div class="editablepage window">                      
                        <div class="content">
                        </div>                                
                    </div>
                    <div class="rightdraggable draggable">
                    </div>
                    <div class="attributeeditor window">
                    </div>
                </div>
            </div>
        </div>
    

</body>
<script type="text/javascript" src="/HighFlyersUkCouriers/public/js/ContentManager.js"></script>
</html>
