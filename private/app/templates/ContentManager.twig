{% extends 'boilerplate.twig' %}
    {% block content %}
        <div class="body">
    
            <header>
                <nav id="contentmanagermenu">
                    <a class="navLinks" href="/HighFlyersUkCouriers/public/logout">Logout</a>
                    <a class="navLinks" href="/HighFlyersUkCouriers/public/content-manager">Content Manager</a>
                    <a class="navLinks" href="/HighFlyersUkCouriers/public/manage-orders">Manage Bookings</a>
                    <a class="navLinks" href="/HighFlyersUkCouriers/public/manage-accounts">Manage Accounts</a>
                
                </nav>
            </header>
            <div class="contentmanagermaincontent">
                <div class="contentmanagerwrapper">
                    <div class="objecttreewindow window">
                        <div class="selectpagewrapper">  
                            
                            <form method="post" action="content-manager">
                                <input id="editabledocumentvalue" type="hidden" name="editabledocumentvalue">
                                <input id="filename" type="hidden" name="filename">
                                <input is="save" type="button" onclick="savePage()" value="Save">
                            </form>                    
                            <select class='selectpage' onchange="selectOnChange()" id="selectpage">
                                <option value="NewHomepage.twig">Homepage</option>
                                <option value="NewBooking.twig">Booking</option>
                                <option value="NewFAQ.twig">FAQ</option>
                                <option value="NewContactUs.twig">ContactUs</option>
                                <option value="PrintableForm.html">Printable Form</option>
                            </select>
                        </div>
                        <div class="objecttree">                            
                        </div>
                    </div>
                    <div class="leftdraggable draggable">              
                    </div>
                    <div class="editablepage window">                      
                        <div class="content">
                        </div>                                
                    </div>
                    <div class="rightdraggable draggable">
                    </div>
                    <div class="attributeeditor window">
                    </div>
                </div>
            </div>
        </div>
    
    {% endblock %}