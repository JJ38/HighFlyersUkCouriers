<!DOCTYPE html>
<html lang="en">
<head>

    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://kit.fontawesome.com/dce6efa4ea.js" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="{{ css_footer_file }}" type="text/css">
    <link rel="stylesheet" href="{{ css_nav_file }}" type="text/css">
    <link rel="stylesheet" href="{{ css_file }}" type="text/css">   
    <title>{{ page_title }}</title>

</head>
<body>
    <div class="body">
        <div class="rightclickmenu hidden" id="rightclickmenu">
            <div class="rootchild list menuitem">Add >
                <div class="listwrapper hidden">
                    <div class="addoptions list menuitem">Before >     
                        <div class="listwrapper hidden">
                            <div id="beforetext" class="menuitem">Text</div>                             
                        </div>                     
                    </div>
                    <div class="addoptions list menuitem">After >
                        <div class="listwrapper hidden">
                            <div id="aftertext" class="menuitem">Text</div>                             
                        </div>
                    </div>               
                </div>
            </div>                                      
            <div class="rootchild menuitem" id="deleteoption">Delete</div>
        </div>

        <header>
            <nav id="contentmanagernav">
                <a href="/logout">Logout</a>
                <a href="/manage-orders">Manage Bookings</a>
                <a href="/content-manager">Content Manager</a>                
                <a href="/manage-accounts">Manage Accounts</a>
            </nav>
        </header>
        <div class="contentmanagermaincontent">
            <div class="contentmanagerwrapper">                    
                <div class="objecttreewindow window">
                    <div class="selectpagewrapper">                          
                        <form method="post" action="content-manager">
                            <input id="editabledocumentvalue" type="hidden" name="editabledocumentvalue">
                            <input id="fontlinks" type="hidden" name="fontlinks">
                            <input id="filename" type="hidden" name="filename">
                            <input is="save" type="button" onclick="savePage()" value="Save">
                        </form>   
                        <form id="selectpageform" name="selectpageform" method="get" action="content-manager">                                           
                            <select form="selectpageform" name="selectedpage" onchange="this.form.submit()" class='selectpage'  id="selectpage">
                                
                                <option value="NewHomepage.twig" {% if selected == "NewHomepage.twig" %} selected {% endif %}>Homepage</option>
                                <option value="NewBooking.twig" {% if selected == "NewBooking.twig" %} selected {% endif %}>Booking</option>
                                <option value="NewFAQ.twig" {% if selected == "NewFAQ.twig" %} selected {% endif %}>FAQ</option>
                                <option value="NewPrices.twig" {% if selected == "NewPrices.twig" %} selected {% endif %}>Prices</option>
                                <option value="NewContactUs.twig" {% if selected == "NewContactUs.twig" %} selected {% endif %}>ContactUs</option>
                        
                            </select>
                        </form>
                    </div>
                    <div class="objecttree">                            
                    </div>
                </div>
                <div class="leftdraggable draggable">              
                </div>
                <div class="editablepage window">                      
                    <div class="content">
                        
                        {{ filedata|raw }}
                    </div>                                
                </div>
                <div class="rightdraggable draggable">
                </div>
                <div class="attributeeditor window">
                </div>
            </div>
        </div>
    </div>
</body>
<script type="text/javascript" src="/js/ContentManager.js"></script>
</html>
