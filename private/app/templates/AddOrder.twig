{% extends 'BoilerPlate.twig' %}
    {% block content %}
  
      <header>
        <nav id="menu">
          <a class="navLinks" href="/manage-orders">Back</a>
        </nav>
      </header>
      <div id="maincontent">
        <section class="formSection">
          <form class="contactUsForm" action="/add-order" method="post">
            <table>
              <tr>
                <td>
                  <label for="animal_type">Bird/Animal type: </label>
                </td>
                <td>
                  <input id="animal_type" name="animal_type" type="text" required>
                </td>
              </tr>

              <tr>
                <td>
                  <label for="quantity">Quantity: </label>
                </td>
                <td>
                  <input id="quantity" name="quantity" type="number" min="1" required>
                </td>
              </tr>

             
              <tr>
                <td>
                  <label for="email">Email Address: </label>
                </td>
                <td>
                  <input id="email" name="email" type="email" required>
                </td>
              </tr>

              <tr>
                <td>
                  <label for="username">Account: </label>
                </td>
                <td>
                    <input id="username" name="username" type="text">
                
                </td>
              </tr>

              <tr>
                <td>                 
                    <label for="delivery_week">Delivery Week: </label>  
                </td>
                <td>
                  {% if isAdmin == true %}
                    <input id="delivery_week" name="delivery_week" type="number" min="1" max="53">
                  {% endif %}
                </td>
              </tr>

              
              <tr>
                <td>
                  <label for="collection_name">Collection Name: </label>
                </td>
                <td>
                  <input id="collection_name" name="collection_name" type="text" required>
                </td>
              </tr>


              <tr>
                <td>
                  <label for="collection_address_1">Collection Address 1: </label>
                </td>
                <td>
                  <input id="collection_address_1" name="collection_address_1" type="text" required>
                </td>
              </tr>

              <tr>
                <td>
                  <label for="collection_address_2">Collection Address 2: </label>
                </td>
                <td>
                  <input id="collection_address_2" name="collection_address_2" type="text">
                </td>
              </tr>

              <tr>
                <td>
                  <label for="collection_address_3">Collection Address 3: </label>
                </td>
                <td>
                  <input id="collection_address_3" name="collection_address_3" type="text">
                </td>
              </tr>

              <tr>
                <td>
                  <label for="collection_postcode">Collection Postcode: </label>
                </td>
                <td>
                  <input id="collection_postcode" name="collection_postcode" type="text" required>
                </td>
              </tr>

               <tr>
                <td>
                  <label for="collection_phone_number">Collection Telephone number: </label>
                </td>
                <td>
                  <input id="collection_phone_number" name="collection_phone_number" type="text" minlength="11" maxlength="12" required>
                </td>
              </tr>


              <tr>
                <td>
                  <label for="delivery_name">Delivery Name: </label>
                </td>
                <td>
                  <input id="delivery_name" name="delivery_name" type="text" required>
                </td>
              </tr>

              <tr>
                <td>
                  <label for="delivery_address_1">Delivery Address Line 1: </label>
                </td>
                <td>
                  <input id="delivery_address_1" name="delivery_address_1" type="text" required>
                </td>
              </tr>

              <tr>
                <td>
                  <label for="delivery_address_2">Delivery Address Line 2: </label>
                </td>
                <td>
                  <input id="delivery_address_2" name="delivery_address_2" type="text">
                </td>
              </tr>

              <tr>
                <td>
                  <label for="delivery_address_3">Delivery Address Line 3: </label>
                </td>
                <td>
                  <input id="delivery_address_3" name="delivery_address_3" type="text">
                </td>
              </tr>

              <tr>
                <td>
                  <label for="delivery_postcode">Delivery Postcode: </label>
                </td>
                <td>
                  <input id="delivery_postcode" name="delivery_postcode" type="text" required>
                </td>
              </tr>

              <tr>
                <td>
                  <label for="delivery_phone_number">Delivery Telephone Number: </label>
                </td>
                <td>
                  <input id="delivery_phone_number" name="delivery_phone_number" type="text" minlength="11" maxlength="12" required>
                </td>
              </tr>

              <tr>
                <td>
                  <label for="payment_option">Payment on Delivery or Collection?: </label>
                </td>
                <td>
                  <select name="payment_option" id="payment_option" required>
                    <option value=""> -- select an option -- </option>
                    <option value="Collection">Collection</option>
                    <option value="Delivery">Delivery</option>
                  </select>
                </td>
              </tr>

              <tr>
                <td>
                  <label for="message">Message: </label>
                </td>
                <td>
                  <textarea id="message" name="message" rows="8" wrap="soft"></textarea>
                </td>
              </tr>

              <tr>
                <td>
                  <label for="code">Code: </label>
                </td>
                <td>
                  <input id="code" name="code" type="text">
                </td>
              </tr>
            </table>

            <input class="submitButton" type="submit" value="submit" aria-label="Submit">
          </form>
        </section>
      </div>
  

    {% endblock %}
