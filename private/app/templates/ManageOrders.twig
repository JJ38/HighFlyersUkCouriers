{% extends 'BoilerPlate.twig' %}
    {% block content %}
      <div id="wrapper">
        <header>
          <nav id="menu">
            <a class="navLinks" href="/logout">Logout</a>
            <a class="navLinks" href="/manage-orders">Manage Bookings</a>
            {% if isAdmin == true %}
              <a class="navLinks" href="/content-manager">Content Manager</a>
              <a class="navLinks" href="/manage-accounts">Manage Accounts</a>
            {% endif %}
          </nav>
        </header>
        <div id="maincontent">

          <div class="orderviewcontainer">
            <div class="searchbar bubble">
              <div class="searchoption">Filter</div>
              <form action="/manage-orders" method="get">
                <select class="searchoption" name="field" id="filter">
                  <option disabled selected value> -- select an option -- </option>
                  <option value="id">ID</option>
                  <option value="animal_type">Animal Type</option>
                  <option value="quantity">Quantity</option>
                  <option value="email">Email</option>
                  <option value="username">Account</option>
                  <option value="delivery_week">Delivery Week</option>
                  <option value="collection_phone_number">Phone Number</option>
                  <option value="collection_name">Collection Name</option>
                  <option value="collection_address_1">Collection Address 1</option>
                  <option value="collection_address_2">Collection Address 2</option>
                  <option value="collection_address_3">Collection Address 3</option>
                  <option value="collection_postcode">Collection Postcode</option>
                  <option value="delivery_name">Delivery Name</option>
                  <option value="delivery_address_1">Delivery Address 1</option>
                  <option value="delivery_address_2">Delivery Address 2</option>
                  <option value="delivery_address_3">Delivery Address 3</option>
                  <option value="delivery_postcode">Delivery Postcode</option>
                  <option value="delivery_phone_number">Delivery Phone Number</option>
                  <option value="payment_option">Payment</option>
                  <option value="message">Message</option>
                </select>
                <input class="searchoption" type="text" id="search" name="filter" placeholder="search value">

                <button class="searchoption" type="submit">Search</button>
              </form>
              <a href="/add-order">
                <button class="searchoption" type="button">Add</button>
              </a>
            </div>

            <div class="massactionbuttons">
                <form>
                  <button id="selectall" class="massactionbutton" onclick="selectAll()" type="button">Select all</button> 
                </form>
                <form id="deleteselectedform" action="/delete-multiple-orders" method="get">              
                  <button id="deleteselected" class="massactionbutton" onclick="deleteSelected()" type="button">Delete Selected</button>
                </form>
                <form id="printselectedform" action="" method="get">
                  <button id="printselected" class="massactionbutton" onclick="printSelected()" type="button">Print Selected</button>
                </form>
            </div>

            <div class="bubble orderdatawrapper">         
              <div class="orderdata">
                <table>
                    <tr class="headerrow">
                      <th></th>
                      <th>ID</th>
                      <th>Animal Type</th>
                      <th>Quantity</th>
                      <th>Email</th>
                      <th>Account</th>
                      <th>Delivery Week</th>
                      <th>Collection Name</th> 
                      <th>Collection Address 1</th>
                      <th>Collection Address 2</th>
                      <th>Collection Address 3</th>
                      <th>Collection Postcode</th>
                      <th>Collection Phone Number</th>
                      <th>Delivery Name</th>
                      <th>Delivery Address 1</th>
                      <th>Delivery Address 2</th>
                      <th>Delivery Address 3</th>
                      <th>Delivery Postcode</th>
                      <th>Delivery Phone Number</th>
                      <th>Payment</th>
                      <th>Message</th>
                      <th>Time</th>
                      <th></th>
                    </tr>

                    {{ orderdata|raw }}

                </table>
              </div>     
            </div>
          </div>
        </div>
      </div>
    {% endblock %}
