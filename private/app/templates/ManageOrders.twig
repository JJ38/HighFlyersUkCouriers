{% extends 'boilerplate.twig' %}
    {% block content %}
      <div id="wrapper">
        <header>
          <nav id="menu">
            <a class="navLinks" href="/HighFlyersUkCouriers/public/logout">Logout</a>
            <a class="navLinks" href="/HighFlyersUkCouriers/public/manage-orders">Manage Bookings</a>
            <a class="navLinks" href="/HighFlyersUkCouriers/public/manage-accounts">Manage Accounts</a>
          </nav>
        </header>
        <div id="maincontent">

          <div class="orderviewcontainer">
            <div class="searchbar bubble">
              <div class="searchoption">Filter</div>
              <form action="/HighFlyersUkCouriers/public/manage-orders" method="get">
                <select class="searchoption" name="field" id="filter">
                  <option disabled selected value> -- select an option -- </option>
                  <option value="id">ID</option>
                  <option value="animal_type">AnimalType</option>
                  <option value="quantity">Quantity</option>
                  <option value="email">Email</option>
                  <option value="collection_phone_number">PhoneNumber</option>
                  <option value="collection_address_1">CollectionAddress1</option>
                  <option value="collection_address_2">CollectionAddress2</option>
                  <option value="collection_address_3">CollectionAddress3</option>
                  <option value="collection_postcode">CollectionPostcode</option>
                  <option value="delivery_address_1">DeliveryAddress1</option>
                  <option value="delivery_address_2">DeliveryAddress2</option>
                  <option value="delivery_address_3">DeliveryAddress3</option>
                  <option value="delivery_postcode">DeliveryPostcode</option>
                  <option value="delivery_phone_number">DeliveryPhoneNumber</option>
                  <option value="payment_option">Payment</option>
                  <option value="message">Message</option>
                </select>
                <input class="searchoption" type="text" id="search" name="filter" placeholder="search value">

                <button class="searchoption" type="submit">Search</button>
              </form>
              <a href="/HighFlyersUkCouriers/public/add-order">
                <button class="searchoption" type="button">Add</button>
              </a>
            </div>
            <div class="bubble">
              <div class="orderdata">
                <table>

                    <tr class="headerrow">
                      <th>ID</th>
                      <th>Animal Type</th>
                      <th>Quantity</th>
                      <th>Email</th>
                      <th>Phone Number</th>
                      <th>Collection Address 1</th>
                      <th>Collection Address 2</th>
                      <th>Collection Address 3</th>
                      <th>Collection Postcode</th>
                      <th>Delivery Name</th>
                      <th>Delivery Address 1</th>
                      <th>Delivery Address 2</th>
                      <th>Delivery Address 3</th>
                      <th>Delivery Postcode</th>
                      <th>Delivery Phone Number</th>
                      <th>Payment</th>
                      <th>Message</th>
                      <th>Time</th>
                      <th></th>
                    </tr>

                  <div class="tabledata">
                    {{ orderdata|raw }}
                  </div>

                </table>
              </div>
            </div>
          </div>

        </div>
      </div>
    {% endblock %}
