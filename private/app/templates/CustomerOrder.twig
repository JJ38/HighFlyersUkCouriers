<!DOCTYPE html>
<html>
    <head>
        <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/css/NavigationBar.css" type="text/css">
        <link rel="stylesheet" href="/css/MobileNavigationBar.css" type="text/css">
        <link rel="stylesheet" href="/css/CustomerOrder.css" type="text/css">
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@48,400,0,0" />
    </head>
    <body>
        <header>
            <div id="mobilenavmenu"  class="hideMobileMenu">
                <div id="mobilenavwrapper">
                <div id="closemobilenavmenu"><p id="closenavtext">close</p><p>X</p></div>
                    <a href="/logout">Logout</a>
                    <a class="currentpage" href="/customer-order">Order</a>
                    <a href="/customer-profile">Profile</a>            
                </div>
            </div>
            <nav class="menu" contenteditable="false">
                 <div id="mobilenavtoggle">
                    <div></div>
                    <div></div>
                    <div></div>
                </div>
                <a class="navLinks" href="/logout">Logout</a>
                <div>
                    <a class="navLinks" href="/customer-order">Order</a>
                    <div class="underlineOrder"></div>
                </div>
                <div>
                    <a class="navLinks" href="/customer-profile">Profile</a>
                    <div class="underlineProfile"></div>
                </div>
            </nav>
        </header>
        <div id="maincontent">
            <div class="bubble orderwindow">
                <section class="toprow">
                    <h1>
                        Order info
                    </h1>
                    <button onclick="addToBasket()">
                        Add To Basket
                    </button>
                </section>
                <hr>
                <section id="orderinfo" class="info">
                    <div class="forminput">
                        <label for="" class="">Animal*</label>
                        <input id="animal" name="" type="text" required="">
                    </div>
                    <div class="forminput">
                        <label for="" class="flex">Quantity*<p class="hinttext">(number of birds/boxes)</p></label>
                        <input id="quantity" name="" type="number" required="">
                    </div>
                     <div class="forminput">
                        <label for="" class="flex">Code <p class="hinttext">(optional)</p></label>
                        <input id="code" name="" type="text">
                    </div>
                </section>            
                <h1>
                    Collection info
                </h1>
                <hr>
                <section class="profiledata">
                    <input id="profileemail" name="profileemail" type="hidden" value={{ email|raw }}>
                    <div id="quickaddress" class="quickcollectionaddresswrapper">
                        <p id="collectionaddressarrow"><</p>
                        <p id="quickAddressName">{{ collection_name|raw }}</p>
                        <div class="flex collectionaddressdetailswrapper"><p id="quickAddress1">{{ collection_address_1|raw }}</p><p class="comma">,</p><p id="quickAddress2">{{ collection_address_2|raw }}</p><p class="comma">,</p><p id="quickAddress3">{{ collection_address_3|raw }}</p><p class="comma">,</p><p id="quickAddressPostcode">{{ collection_postcode|raw }}</p></div>
                        <p id="quickAddressEmail">{{ email|raw }}</p>
                        <p id="quickAddressTelephone">{{ collection_phone_number|raw }}</p>
                    </div>
                    <section id="collectioninfo" class="info hidden">
                        <div class="forminput">
                            <label for="" class="">Collection Name*</label>
                            <input id="collectionname" name="" type="text" onchange="updateQuickAddressName()" required="">
                        </div>
                        <div class="forminput">
                            <label for="" class="">Collection Postcode*</label>
                            <input id="collectionpostcode" name="" type="text" onchange="updateQuickAddressPostcode()" required="">
                        </div>
                        <div class="forminput">
                            <label for="" class="">Collection Telephone*</label>
                            <input id="collectiontelephone" name="" type="text" onchange="updateQuickAddressTelephone()" minlength="11" maxlength="11" required="">
                        </div>
                        <div class="forminput">
                            <label for="" class="">Collection Address 1*</label>
                            <input id="collectionaddress1" name="" type="text" onchange="updateQuickAddress1()" required="">
                        </div>
                        <div class="forminput">
                            <label for="" class="">Collection Address 2</label>
                            <input id="collectionaddress2" name="" type="text" onchange="updateQuickAddress2()">
                        </div>
                        <div class="forminput">
                            <label for="" class="">Collection Address 3</label>
                            <input id="collectionaddress3" name="" type="text" onchange="updateQuickAddress3()">
                        </div>
                        <div class="forminput">
                            <label for="" class="">Email *</label>
                            <input id="email" name="" type="text" onchange="updateQuickAddressEmail()" required="">
                        </div>
                    </section>
                </section>
                <h1>
                    Delivery info
                </h1>
                <hr>
                <section class="info">
                    <div class="forminput">
                        <label for="" class="">Delivery Name*</label>
                        <input id="deliveryname" name="" type="text" required="">
                    </div>
                    <div class="forminput">
                        <label for="" class="">Delivery Postcode*</label>
                        <input id="deliverypostcode" name="" type="text" required="">
                    </div>
                    <div class="forminput">
                        <label for="" class="">Delivery Telephone*</label>
                        <input id="deliverytelephone" name="" type="text" minlength="11" maxlength="11" required="">
                    </div>
                    <div class="forminput">
                        <label for="" class="">Delivery Address 1*</label>
                        <input id="deliveryaddress1" name="" type="text" required="">
                    </div>
                    <div class="forminput">
                        <label for="" class="">Delivery Address 2</label>
                        <input id="deliveryaddress2" name="" type="text">
                    </div>
                    <div class="forminput">
                        <label for="" class="">Delivery Address 3</label>
                        <input id="deliveryaddress3" name="" type="text">
                    </div>
                </section>
                <h1>
                    Payment info
                </h1>
                <hr>
                <section class="paymentinfo">
                    <div class="forminput">
                        <label for="payment">Payment on Delivery or Collection?*</label>
                        <select name="payment" id="payment" required="">
                            <option value=""> </option>
                            <option value="Collection">Collection</option>
                            <option value="Delivery">Delivery</option>
                            <option value="Account">Account</option>
                        </select>
                    </div>
                    <div class="forminput">
                        <label class="flex" for="message">Message <p class="hinttext">(optional)</p></label>
                        <textarea id="message" name="message" rows="4" wrap="soft"></textarea>
                    </div>
                </section>

            </div>
            <div id="basket" class="hidden">
                <h1>
                    Basket
                </h1>
                <div id="table">
                    <div class="columns tablerow headerrow">         
                    
                        <h3>Animal</h3>
                        <h3>Quantity</h3>
                        <h3>Name</h3>
                        <h3>Delivery address</h3>
                        <h3>Delivery telephone</h3>
                        <h3>Payment</h3>
                        <h3></h3>

                    </div>
            
                </div>
                <div id="submitbuttonwrapper">
                    <div id="loadingsymbol"></div>
                    <button id="submitorders" type="button" onclick="submitOrders()">Submit Orders</button>
                </div>
                <form method="post" action="/customer-order">
                </form>
                <br>
                
            </div>
        </div>
        <script src="https://kit.fontawesome.com/dce6efa4ea.js" crossorigin="anonymous"></script>
        <script src="/js/CustomerOrder.js" crossorigin="anonymous"></script>
        <script type="text/javascript" src="/js/MobileNavigationBar.js"></script>

    </body>
</html>
