<!DOCTYPE html>
<html>
    <header>
        <link rel="stylesheet" href="/HighFlyersUkCouriers/public/css/NavigationBar.css" type="text/css">
        <link rel="stylesheet" href="/HighFlyersUkCouriers/public/css/CustomerOrder.css" type="text/css">
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@48,400,0,0" />
        
    </header>
    
    <body>
        <nav class="menu" contenteditable="false">
            <a class="navLinks" href="/HighFlyersUkCouriers/public/logout">Logout</a>
            <div>
                <a class="navLinks" href="/HighFlyersUkCouriers/public/customer-order">Order</a>
                <div class="underlineOrder"></div>
            </div>
            <div>
                <a class="navLinks" href="/HighFlyersUkCouriers/public/customer-profile">Profile</a>
                <div class="underlineProfile"></div>
            </div>
        </nav>
        <div id="maincontent">
            <div class="bubble orderwindow">
                <section class="toprow">
                    <h1>
                        Collection info
                    </h1>
                    <button>
                        Add To Basket
                    </button>
                </section>
                <hr>
                <section class="profiledata">
                    <div class="quickcollectionaddresswrapper">
                        <p id="collectionaddressarrow"><</p>
                        <p>James</p>
                        <p>10 Kenilworth Road, Ripley, Derbyshire, DE5 3GY</p>
                    </div>
                    <section id="collectioninfo" class="info hidden">
                        <div class="forminput">
                            <label for="" class="">Collection Name</label>
                            <input id="collectionname" name="" type="text" required="">
                        </div>
                        <div class="forminput">
                            <label for="" class="">Collection Postcode</label>
                            <input id="collectionpostcode" name="" type="text" required="">
                        </div>
                        <div class="forminput">
                            <label for="" class="">Collection Telephone</label>
                            <input id="collectiontelephone" name="" type="text" required="">
                        </div>
                        <div class="forminput">
                            <label for="" class="">Collection Address 1</label>
                            <input id="collectionaddress1" name="" type="text" required="">
                        </div>
                        <div class="forminput">
                            <label for="" class="">Collection Address 2</label>
                            <input id="collectionaddress2" name="" type="text" required="">
                        </div>
                        <div class="forminput">
                            <label for="" class="">Collection Address 3</label>
                            <input id="collectionaddress3" name="" type="text" required="">
                        </div>
                    </section>
                    {# {{ profiledata|raw }} #}
                </section>
                <h1>
                    Delivery info
                </h1>
                <hr>
                <section class="info">
                    <div class="forminput">
                        <label for="" class="">Delivery Name</label>
                        <input id="deliveryname" name="" type="text" required="">
                    </div>
                    <div class="forminput">
                        <label for="" class="">Delivery Postcode</label>
                        <input id="deliverypostcode" name="" type="text" required="">
                    </div>
                    <div class="forminput">
                        <label for="" class="">Delivery Telephone</label>
                        <input id="deliverytelephone" name="" type="text" required="">
                    </div>
                    <div class="forminput">
                        <label for="" class="">Delivery Address 1</label>
                        <input id="deliveryaddress1" name="" type="text" required="">
                    </div>
                    <div class="forminput">
                        <label for="" class="">Delivery Address 2</label>
                        <input id="deliveryaddress2" name="" type="text" required="">
                    </div>
                    <div class="forminput">
                        <label for="" class="">Delivery Address 3</label>
                        <input id="deliveryaddress3" name="" type="text" required="">
                    </div>
                </section>
                <h1>
                    Payment info
                </h1>
                <hr>
                <section class="paymentinfo">
                    <div class="forminput">
                        <label for="payment">Payment on Delivery or Collection?</label>
                        <select name="payment" id="payment" required="">
                            <option value=""> </option>
                            <option value="Collection">Collection</option>
                            <option value="Delivery">Delivery</option>
                        </select>
                    </div>
                    <div class="forminput">
                        <label for="message">Message</label>
                        <textarea id="message" name="message" rows="4" wrap="soft" required=""></textarea>
                    </div>
                </section>

            </div>
            <h1>
                Basket
            </h1>
            <div>
                <div class="columns tablerow headerrow">         
                
                    <h3>Animal</h3>
                    <h3>Quantity</h3>
                    <h3>Name</h3>
                    <h3>Delivery address</h3>
                    <h3>Delivery telephone</h3>
                    <h3>Payment</h3>
                    <h3></h3>

                </div>

                <div class="tablerow">          
                    <div class="transportinfowrapper">   
                        <div class="hidden collectiondeliveryicons transporticons">
                            <i class="fa-solid fa-box-open" title="collection"></i> 
                            <i class="fa-solid fa-ellipsis-vertical"></i>
                            <i class="fa-solid fa-truck" title="delivery"></i>    
                        </div>              
                        <div class="columns hidden collectioninfomargin">
                            <p>Pigeon</p>
                            <p>10</p>
                            <p>Katherine</p>
                            <p>8 Marston, Belper, Derbyshire, DE56 1TP</p>
                            <p>07842133519</p>   
