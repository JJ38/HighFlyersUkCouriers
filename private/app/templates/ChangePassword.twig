{% extends 'BoilerPlate.twig' %}
    {% block content %}
   
      <header>
        <nav id="menu">
          <a class="navLinks" href="/manage-orders">Back</a>
        </nav>
      </header>
      <div id="maincontent">
        <section class="formSection">
          <form class="contactUsForm" action="/change-password" method="post">
            <table>

              <tr>
                <td>
                  <label for="password">New Password: </label>
                </td>
                <td>
                  <input id="password" name="password" type="text" minlength="8" required>
                </td>
              </tr>

              <tr>
                <td>
                  <label for="confirmpassword">Confirm Password: </label>
                </td>
                <td>
                  <input id="confirmpassword" name="confirmpassword" type="text" minlength="8" required>
                </td>
              </tr>
              <input id="accountid" type="hidden" value={{ userid|raw }} name="accountid">
            </table>
                

            <input class="submitButton" type="submit" value="submit" aria-label="Submit">
          </form>
        </section>
      </div>


    {% endblock %}