<!DOCTYPE html><html><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><script src="https://kit.fontawesome.com/dce6efa4ea.js" crossorigin="anonymous"></script><title>{{ page_title }}</title><link rel="stylesheet" href="/HighFlyersUkCouriers/public/css/Footer.css" type="text/css"><link rel="stylesheet" href="/HighFlyersUkCouriers/public/css/NavigationBar.css" type="text/css"><link rel="stylesheet" href="/HighFlyersUkCouriers/public/css/NewBooking.css" type="text/css"><link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Times New Roman" id="TimesNew Roman"><link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto Slab" id="RobotoSlab"><link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Raleway" id="Raleway"></head><body><header class="" contenteditable="false">
